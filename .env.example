# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated Certly staff emails for the platform admin console.
CERTLY_PLATFORM_ADMINS=

# Optional: fallback due-soon window in days, used only when an organisation
# has no due_soon_days of its own. Per-org value is the real source.
DEFAULT_DUE_SOON_DAYS=30

# Certificate reading. Required for /hr/certifications/scan.
ANTHROPIC_API_KEY=
# Optional: override the extraction model. Defaults to claude-sonnet-5.
# claude-haiku-4-5-20251001 is cheaper and usually enough for clean scans.
CERTLY_EXTRACTION_MODEL=

# PayFast. Without these the billing screen says payments are not connected
# and nobody can subscribe; nothing else breaks.
# Sandbox test values: merchant id 10000100, key 46f0cd694581a.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set this to the passphrase configured on the PayFast account, or leave it
# empty if the account has none. A mismatch either way fails every signature
# and PayFast reports only a generic error.
PAYFAST_PASSPHRASE=
# "true" posts to sandbox.payfast.co.za. Anything else goes live.
PAYFAST_SANDBOX=true

# Email. Without these no digest is sent and nothing else breaks.
# The sending domain must be verified in Resend first.
RESEND_API_KEY=
CERTLY_EMAIL_FROM="Certly <alerts@certly.co.za>"
CERTLY_EMAIL_REPLY_TO=

# Shared secret for the scheduled jobs at /api/cron/*. Without it those
# endpoints answer 404 to everyone, including Vercel, so the jobs simply do
# not run. Vercel sends it automatically as a bearer token when the env var
# is named CRON_SECRET.
CRON_SECRET=

# Absolute origin used in emails, which have no request to read a host from.
CERTLY_PUBLIC_ORIGIN=https://certly.co.za

# Lowers the base monthly price for a live payment test, in cents.
# Leave unset in normal operation. It can only lower the price, never raise it,
# and never below 100 cents. Remove it and redeploy once the test is done.
CERTLY_BASE_PRICE_CENTS=
