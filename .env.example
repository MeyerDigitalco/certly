# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings -> API). Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated Certly staff emails for the platform admin console.
CERTLY_PLATFORM_ADMINS=

# Optional: fallback due-soon window in days, used only when an organisation
# has no due_soon_days of its own. Per-org value is the real source.
DEFAULT_DUE_SOON_DAYS=30

# Optional: certificate vision extraction (later phase).
ANTHROPIC_API_KEY=
